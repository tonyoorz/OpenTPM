#=====================================================================#
#          LibreChat 生产级部署 — BMW 内网环境变量模板                  #
#                                                                     #
#  使用方法:                                                           #
#    1. cp .env.prod.example .env                                     #
#    2. 填入真实值（标注 ❰必填❱ 的必须设置）                            #
#    3. docker compose -f docker-compose.prod.yml build && up -d      #
#=====================================================================#

#==================================================#
#               Server Configuration               #
#==================================================#

HOST=0.0.0.0
PORT=3080

# ❰必填❱ 内网访问地址 — 改成你的实际 IP 或域名
DOMAIN_CLIENT=http://10.165.22.10:3080
DOMAIN_SERVER=http://10.165.22.10:3080

#==================================================#
#               MongoDB Configuration               #
#==================================================#

# ❰必填❱ MongoDB root 凭据（仅用于初始化，不要用于应用连接）
MONGO_ROOT_USER=librechat
MONGO_ROOT_PASSWORD=❰生成一个强密码❱

# ❰必填❱ 应用专用的低权限用户密码（mongo-init.js 自动创建该用户）
MONGO_APP_PASSWORD=❰生成一个强密码❱

# 应用连接串 — 使用 app 用户（非 root），指向 compose 内的 mongodb 服务
MONGO_URI=mongodb://librechat_app:❰MONGO_APP_PASSWORD❱@mongodb:27017/LibreChat?authSource=LibreChat

# WiredTiger 缓存大小（GB），建议设为容器内存的 50%
MONGO_CACHE_GB=2

#==================================================#
#            Secrets & Encryption Keys              #
#==================================================#

# ❰必填❱ JWT 签名密钥（openssl rand -hex 48）
JWT_SECRET=❰生成❱

# ❰必填❱ 凭据加密密钥对（openssl rand -hex 32）
CREDS_KEY=❰生成❱
CREDS_IV=❰生成❱

# ❰必填❱ 会话密钥（openssl rand -hex 32）
SESSION_SECRET=❰生成❱

#==================================================#
#               BMW Beacon LLM Models               #
#==================================================#

# ❰必填❱ Beacon GoLive channel API key
BEACON_API_KEY=❰你的 Beacon GoLive key❱

# ❰必填❱ Beacon Personal channel API key
BEACON_PERSONAL_API_KEY=❰你的 Beacon Personal key❱

#==================================================#
#               BMW SSO (session_keeper)            #
#==================================================#

BMW_SSO_ENABLED=true
BMW_SSO_TOOL_KEY=octane
BMW_SSO_LOGIN_TIMEOUT_MS=120000

# session_keeper 服务地址:
#   - 如果 session_keeper 跑在宿主机上 → http://host.docker.internal:8090
#   - 如果 session_keeper 也在 compose 里 → http://session_keeper:8090
SESSION_KEEPER_URL=http://host.docker.internal:8090

#==================================================#
#               Confluence MCP                     #
#==================================================#

CONFLUENCE_TOKEN=❰你的 Confluence PAT❱

#==================================================#
#               Endpoints & Features                #
#==================================================#

# 仅显示自定义 Beacon 端点和 agents（隐藏内置 openAI/anthropic/google）
ENDPOINTS=custom,agents

# 注册与登录策略
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# 搜索: 默认关闭，如需 Meilisearch 则设为 true 并启动 search profile
SEARCH=false
MEILI_NO_ANALYTICS=true
# MEILI_MASTER_KEY=❰如启用搜索则必填❱

#==================================================#
#               Node.js 调优                         #
#==================================================#

# 前端构建时 Node 最大堆内存（MB）
NODE_MAX_OLD_SPACE_SIZE=6144

# JSON 日志（生产环境推荐开启，方便日志收集）
CONSOLE_JSON=true

# 代理: BMW 内网如需访问外网资源
# PROXY=http://proxychina.bmwgroup.net:8080
# HTTP_PROXY=http://proxychina.bmwgroup.net:8080
# HTTPS_PROXY=http://proxychina.bmwgroup.net:8080
# NO_PROXY=localhost,127.0.0.1,::1,mongodb,beaconapi.bmwbrill.cn,atc.bmwgroup.net,host.docker.internal

#==================================================#
#               RAG (可选，默认关闭)                  #
#==================================================#

# 如需启用 RAG:
#   docker compose -f docker-compose.prod.yml --profile rag up -d
# RAG_PORT=8000
# PG_DB=librechat_rag
# PG_USER=rag_user
# PG_PASSWORD=❰生成❱
